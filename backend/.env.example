# ==========================================
# NEXORA BACKEND CONFIGURATION
# Copy this file to .env and replace placeholders
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.mongodb.net/nexora?retryWrites=true&w=majority

# JSON Web Token Secret (Use a strong random 256-bit string)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min32chars

# JWT Expiration Time (e.g. 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Google Workspace / Calendar / Meet Integration (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/meetings/oauth2callback

# AI / Meeting Transcript Analyzer Model Integration (Optional)
# Required to transcribe uploaded Google Meet recordings (audio/video) and for richer summaries.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder
